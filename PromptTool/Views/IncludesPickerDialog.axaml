<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PromptTool.Views.IncludesPickerDialog"
        x:CompileBindings="False"
        Title="Set Include"
        Width="460"
        Height="440"
        MinWidth="360"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Border Classes="dialog-root">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource DialogRowSpacing}">
            <StackPanel Grid.Row="0" Classes="dialog-header">
                <TextBlock Classes="dialog-title" Text="Set Include"/>
                <TextBlock Text="Pick a wildcard to include." Classes="subtle" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Wildcard" FontWeight="Bold"/>
                    <CheckBox x:Name="RecentFirstToggle" Content="Recent first"/>
                </StackPanel>
                <TextBox x:Name="WildcardFilterBox" Grid.Row="1" Watermark="Filter wildcards..."/>
                <ListBox x:Name="WildcardListBox" Grid.Row="2"
                         MinHeight="200"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       ToolTip.ShowDelay="600"
                                       ToolTip.Tip="{Binding Preview}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <StackPanel Grid.Row="2" Classes="dialog-footer">
                <Button Content="Cancel" Width="90" Click="OnCancel" IsCancel="True"/>
                <Button Content="OK" Width="90" Click="OnOk" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
