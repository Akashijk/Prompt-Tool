<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PromptTool.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="PromptTool.Views.LoraPermutationDialog"
        x:DataType="vm:LoraPermutationDialogViewModel"
        x:CompileBindings="False"
        Title="Generate LoRA Permutations"
        WindowStartupLocation="CenterOwner"
        Width="900"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        SizeToContent="Manual">

    <Border Classes="dialog-root">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource DialogRowSpacing}">
            <StackPanel Grid.Row="0" Classes="dialog-header">
                <TextBlock Classes="dialog-title" Text="Generate LoRA Permutations"/>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="2.2*,3*,2.2*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Permutations" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SummaryText}" Classes="subtle"/>
                        </StackPanel>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Permutations}"
                                 SelectedItem="{Binding SelectedPermutation, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LoraPermutationViewModel">
                                    <Border Padding="8"
                                            Margin="0,0,0,6"
                                            BorderBrush="#404040"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Summary}"
                                                       Classes="subtle"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="40"/>
                                            <TextBlock Text="{Binding DuplicateLabel}"
                                                       Foreground="Tomato"
                                                       IsVisible="{Binding HasDuplicates}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="2" ItemSpacing="6" LineSpacing="6">
                            <Button Content="Add" Command="{Binding AddPermutationCommand}"/>
                            <Button Content="Duplicate" Command="{Binding DuplicatePermutationCommand}"/>
                            <Button Content="Remove" Command="{Binding RemovePermutationCommand}"/>
                            <Button Content="Clear LoRAs" Command="{Binding ClearSelectedPermutationCommand}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="LoRA Stack" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedPermutation.DisplayName}" Classes="subtle"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="Adjust weights per LoRA. Quick buttons set common values."
                                   Classes="subtle"/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedPermutation.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LoraPermutationRowViewModel">
                                        <Border Padding="8"
                                                Margin="0,0,0,8"
                                                BorderBrush="#404040"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid ColumnDefinitions="2*,Auto,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="Weight" VerticalAlignment="Center"/>
                                                    <NumericUpDown Value="{Binding Weight, Mode=TwoWay}"
                                                                   Minimum="-1"
                                                                   Maximum="2"
                                                                   Increment="0.05"
                                                                   FormatString="F2"
                                                                   Width="110"/>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="Remove"
                                                        Command="{Binding DataContext.DeleteLoraRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding .}"/>
                                                <StackPanel Grid.Row="1"
                                                            Grid.Column="0"
                                                            Orientation="Horizontal"
                                                            Spacing="6">
                                                    <Button Content="0.5" Command="{Binding SetWeightCommand}" CommandParameter="0.5"/>
                                                    <Button Content="0.75" Command="{Binding SetWeightCommand}" CommandParameter="0.75"/>
                                                    <Button Content="1.0" Command="{Binding SetWeightCommand}" CommandParameter="1.0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                        <TextBlock Text="LoRA Library" FontWeight="Bold"/>
                        <TextBox Grid.Row="1"
                                 Text="{Binding LoraSearchText}"
                                 Watermark="Search LoRAs..."/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredLoraOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LoraOptionViewModel">
                                        <Border Padding="8"
                                                Margin="0,0,0,8"
                                                BorderBrush="#404040"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1"
                                                        Content="Add"
                                                        Command="{Binding DataContext.AddLoraOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding .}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Classes="dialog-footer">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"/>
                <Button Content="Generate" Command="{Binding GenerateCommand}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
