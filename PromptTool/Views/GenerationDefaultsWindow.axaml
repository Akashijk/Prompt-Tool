<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PromptTool.ViewModels"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="380"
        x:Class="PromptTool.Views.GenerationDefaultsWindow"
        x:DataType="vm:GenerationDefaultsViewModel"
        Title="Default Generation Options"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        MinWidth="420">

    <Design.DataContext>
        <vm:GenerationDefaultsViewModel />
    </Design.DataContext>

    <Border Classes="dialog-root">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource DialogRowSpacing}">
            <StackPanel Grid.Row="0" Classes="dialog-header">
                <TextBlock Classes="dialog-title" Text="Default Generation Options"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource DialogSectionSpacing}" Width="420">
                    <TextBlock Text="Scheduler:" FontWeight="Bold" />
                    <ComboBox ItemsSource="{Binding Schedulers}"
                              SelectedItem="{Binding SelectedSchedulerOption}"
                              Width="320"
                              HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SchedulerOption">
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Base Model Type:" FontWeight="Bold" />
                    <ComboBox ItemsSource="{Binding BaseModelTypes}"
                              SelectedItem="{Binding DefaultBaseModelType}" />

                    <TextBlock Text="Steps:" FontWeight="Bold" />
                    <NumericUpDown Minimum="1" Maximum="200" Value="{Binding DefaultSteps}" />

                    <TextBlock Text="CFG Scale:" FontWeight="Bold" />
                    <NumericUpDown Minimum="0" Maximum="50" Increment="0.1" Value="{Binding DefaultCfgScale}" />

                    <TextBlock Text="CFG Rescale Multiplier:" FontWeight="Bold" />
                    <NumericUpDown Minimum="0" Maximum="10" Increment="0.1" Value="{Binding DefaultCfgRescaleMultiplier}" />

                    <TextBlock Text="Width:" FontWeight="Bold" />
                    <NumericUpDown Minimum="64" Maximum="4096" Increment="64" Value="{Binding DefaultWidth}" />

                    <TextBlock Text="Height:" FontWeight="Bold" />
                    <NumericUpDown Minimum="64" Maximum="4096" Increment="64" Value="{Binding DefaultHeight}" />

                    <CheckBox Content="Save to gallery by default" IsChecked="{Binding DefaultSaveToGallery}" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Classes="dialog-footer">
                <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
