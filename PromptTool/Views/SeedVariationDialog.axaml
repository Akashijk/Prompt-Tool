<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PromptTool.Views.SeedVariationDialog"
        Title="Seed Variations"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Border Classes="dialog-root">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource DialogRowSpacing}">
            <StackPanel Grid.Row="0" Classes="dialog-header">
                <TextBlock Classes="dialog-title" Text="{Binding $parent[Window].Title}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="{StaticResource DialogSectionSpacing}">
                <TextBlock Text="Generate multiple variations using specific or random seeds." TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Start seed" VerticalAlignment="Center"/>
                    <NumericUpDown x:Name="StartSeedInput"
                                   Minimum="0"
                                   Maximum="2147483647"
                                   Width="220"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="End seed" VerticalAlignment="Center"/>
                    <NumericUpDown x:Name="EndSeedInput"
                                   Minimum="0"
                                   Maximum="2147483647"
                                   Width="220"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Count" VerticalAlignment="Center"/>
                    <NumericUpDown x:Name="CountInput"
                                   Minimum="1"
                                   Maximum="100"
                                   Width="220"/>
                </StackPanel>
                <CheckBox x:Name="RandomSeedsCheck"
                          Content="Generate random seeds"
                          Checked="OnRandomSeedsChanged"
                          Unchecked="OnRandomSeedsChanged"/>
                <CheckBox x:Name="MirrorSeedsCheck"
                          Content="Generate before + after root seed"
                          Checked="OnMirrorSeedsChanged"
                          Unchecked="OnMirrorSeedsChanged"/>
                <TextBlock x:Name="TotalCountText"
                           Classes="subtle"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="SeedNoteText"
                           Classes="subtle"
                           TextWrapping="Wrap"
                           IsVisible="False"/>
                <TextBlock x:Name="ErrorText"
                           Foreground="Tomato"
                           TextWrapping="Wrap"
                           IsVisible="False"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Classes="dialog-footer">
                <Button Content="Cancel" Width="90" Click="OnCancel" IsCancel="True"/>
                <Button Content="Generate" Width="90" Click="OnOk" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
