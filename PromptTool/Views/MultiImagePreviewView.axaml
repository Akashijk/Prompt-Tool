<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PromptTool.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="PromptTool.Views.MultiImagePreviewView"
        x:DataType="vm:MultiImagePreviewViewModel"
        Title="Image Preview"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MultiImagePreviewViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,6" ColumnSpacing="10" RowSpacing="4">
            <TextBlock Text="Generated Images" FontWeight="Bold" Grid.Row="0" Grid.Column="0"/>
            <TextBlock Text="{Binding StatusText}" Classes="subtle" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding ProgressText}" Classes="subtle" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding HeaderContextText}"
                       Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Classes="subtle"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HeaderContextText, Converter={StaticResource StringToBoolConverter}}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImageSlotViewModel">
                        <Grid Margin="6" Width="280" DoubleTapped="Slot_DoubleTapped">
                            <Border BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    IsVisible="{Binding IsRootSeed}"/>
                            <Border Padding="6" BorderThickness="0" CornerRadius="4">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding}">
                                        <MenuItem Header="View Full Size" Command="{Binding ShowFullSizeCommand}"/>
                                        <MenuItem Header="Generate Seed Variations"
                                                  Command="{Binding GenerateSeedVariationsCommand}"
                                                  IsVisible="{Binding ShowGenerationActions}"/>
                                        <MenuItem Header="Generate Model Variations"
                                                  Command="{Binding GenerateModelVariationsCommand}"
                                                  IsVisible="{Binding ShowGenerationActions}"/>
                                        <MenuItem Header="Generate LoRA Variations"
                                                  Command="{Binding GenerateLoraVariationsCommand}"
                                                  IsVisible="{Binding ShowGenerationActions}"/>
                                        <MenuItem Header="Edit &amp; Regenerate"
                                                  Command="{Binding EditAndRegenerateCommand}"
                                                  IsVisible="{Binding ShowGenerationActions}"/>
                                        <Separator IsVisible="{Binding ShowGenerationActions}"/>
                                        <MenuItem Header="Promote To Base"
                                                  Command="{Binding PromoteToBaseCommand}"
                                                  IsVisible="{Binding ShowGenerationActions}"/>
                                        <MenuItem Header="Enhance From This"
                                                  Command="{Binding EnhanceFromThisCommand}"
                                                  IsVisible="{Binding ShowGenerationActions}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" >
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Grid.Column="0"/>
                                        <CheckBox Content="Favorite" IsChecked="{Binding IsFavorite}" Grid.Column="1" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="220"
                                            Background="#1a1a1a"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            ToolTip.ShowDelay="650"
                                            ToolTip.BetweenShowDelay="300"
                                            >
                                        <ToolTip.Tip>
                                            <Border MaxWidth="460" Padding="8">
                                                <TextBlock Text="{Binding PromptToolTip}" TextWrapping="Wrap"/>
                                            </Border>
                                        </ToolTip.Tip>
                                        <Grid>
                                            <Image Source="{Binding Image}" Stretch="Uniform" />
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IsLoading}">
                                                <ProgressBar IsIndeterminate="True" Width="120"/>
                                                <TextBlock Text="Generating..." HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding ModelUsed, StringFormat='Model: {0}'}" Classes="subtle"/>
                                        <TextBlock Text="{Binding Seed, StringFormat='Seed: {0}'}" Classes="subtle"/>
                                        <TextBlock Text="{Binding RootSeedLabel}"
                                                   Classes="subtle"
                                                   IsVisible="{Binding RootSeedLabel, Converter={StaticResource StringToBoolConverter}}"/>
                                        <TextBlock Text="{Binding Size, StringFormat='Size: {0}'}" Classes="subtle"/>
                                        <TextBlock Text="{Binding LoraLabel, StringFormat='LoRAs: {0}'}"
                                                   Classes="subtle"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding LoraLabel, Converter={StaticResource StringToBoolConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Discard" Command="{Binding CancelCommand}" />
            <Button Content="Save Selected" Command="{Binding SaveSelectedCommand}" Classes="accent"/>
        </StackPanel>
    </Grid>

</Window>
