<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PromptTool.ViewModels"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="720"
        x:Class="PromptTool.Views.JsonDiffWindow"
        x:DataType="vm:JsonDiffViewModel"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterOwner"
        Width="960"
        Height="720"
        MinWidth="720"
        MinHeight="560"
        SizeToContent="Manual">
    <Border Classes="dialog-root">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource DialogRowSpacing}">
            <StackPanel Grid.Row="0" Classes="dialog-header">
                <TextBlock Classes="dialog-title" Text="{Binding WindowTitle}"/>
                <TextBlock Text="{Binding Summary}" Classes="subtle" TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Border Grid.Row="0"
                            IsVisible="{Binding HasDiffs}"
                            BorderBrush="{DynamicResource BorderBrushStrong}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <ItemsControl ItemsSource="{Binding Diffs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="2*,*,*,Auto" ColumnSpacing="8" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Path}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LeftValue}" Classes="subtle" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="2" Text="{Binding RightValue}" Classes="subtle" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Classes="subtle"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10" x:Name="JsonGrid">
                        <Border Grid.Column="0"
                                x:Name="LeftPanel"
                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding LeftTitle}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding LeftJson}"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Menlo, Courier New"
                                         MinHeight="240"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                x:Name="RightPanel"
                                IsVisible="{Binding HasRightJson}"
                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding RightTitle}" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding RightJson}"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Menlo, Courier New"
                                         MinHeight="240"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <DockPanel Grid.Row="2" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                    <Button Content="Copy Left JSON" Click="CopyLeft_Click"/>
                    <Button Content="Copy Right JSON" Click="CopyRight_Click" IsEnabled="{Binding HasRightJson}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Close" Click="Close_Click" IsDefault="True"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
