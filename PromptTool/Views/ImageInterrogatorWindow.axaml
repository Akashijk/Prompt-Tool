<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PromptTool.ViewModels"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
        x:Class="PromptTool.Views.ImageInterrogatorWindow"
        x:DataType="vm:ImageInterrogatorViewModel"
        Title="Image Interrogator"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:ImageInterrogatorViewModel />
    </Design.DataContext>

    <Border Padding="15">
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Image Path:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Text="{Binding ImagePath}" IsReadOnly="True" MinWidth="300" HorizontalAlignment="Stretch"/>
                <Button Content="Select Image" Command="{Binding SelectImageAsyncCommand}" CommandParameter="{Binding $parent[Window]}"/>
            </StackPanel>

            <Image Source="{Binding ImagePath}" MaxWidth="200" MaxHeight="200" Stretch="Uniform" HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Ollama Model:" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding OllamaModels}" SelectedItem="{Binding SelectedOllamaModel}" MinWidth="200"/>
                <Button Content="Interrogate" Command="{Binding InterrogateImageAsyncCommand}"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="100"/>
            </StackPanel>

            <TextBlock Text="Interrogation Result:" FontWeight="Bold"/>
            <TextBox Text="{Binding InterrogationResult}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="200"/>
        </StackPanel>
    </Border>

</Window>
