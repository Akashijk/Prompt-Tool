<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PromptTool.ViewModels"
        mc:Ignorable="d"
        x:Class="PromptTool.Views.DeployRemoteScorerDialog"
        x:DataType="vm:DeployRemoteScorerDialogViewModel"
        Title="Deploy Remote Aesthetic Scorer (v2.5 Image Model)"
        WindowStartupLocation="CenterOwner"
        Width="980"
        Height="680"
        MinWidth="900"
        MinHeight="620"
        SizeToContent="Manual">

    <Border Classes="dialog-root">
        <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource DialogRowSpacing}">
            <StackPanel Grid.Row="0" Classes="dialog-header">
                <TextBlock Classes="dialog-title" Text="Deploy Remote Aesthetic Scorer (v2.5 Image Model)"/>
                <TextBlock Text="Deploy the FastAPI scorer on a remote Linux server via SSH, or copy/paste the manual instructions." Classes="subtle" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,10,*" RowDefinitions="*">
                <Border Grid.Column="0" Classes="card" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="SSH Deploy (Automatic)" FontWeight="Bold"/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Host" Width="120" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Host}" Width="240"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Port" Width="120" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Username" Width="120" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Username}" Width="240"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Auth Type" Width="120" VerticalAlignment="Center"/>
                                <ComboBox Width="160" ItemsSource="{Binding AuthTypes}" SelectedItem="{Binding AuthType}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsKeyAuth}">
                                <TextBlock Text="Key file path" Width="120" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding KeyFilePath}" Width="320"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPasswordAuth}">
                                <TextBlock Text="Password" Width="120" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Password, Mode=TwoWay}" Width="240" PasswordChar="*"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Remote install dir" Width="120" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding InstallDir}" Width="320"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Exposed port" Width="120" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding ExposedPort}" Minimum="1" Maximum="65535" Width="120"/>
                            </StackPanel>
                            <CheckBox Content="Enable ROCm flags" IsChecked="{Binding EnableRocm}"/>

                            <TextBlock Text="Output Log" FontWeight="Bold" Margin="0,6,0,0"/>
                            <ScrollViewer x:Name="OutputLogScroll" Height="280" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="OutputLogBox"
                                         Text="{Binding OutputLog}"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"/>
                            </ScrollViewer>

                            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Test Connection" Command="{Binding TestConnectionCommand}"/>
                                <Button Content="Deploy" Command="{Binding DeployCommand}" Classes="accent"/>
                                <Button Content="Close" Command="{Binding CloseCommand}" IsCancel="True"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Classes="card" Padding="12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Manual Instructions (Copy/Paste)" FontWeight="Bold"/>
                        <TextBox Text="{Binding ManualInstructions}" AcceptsReturn="True" IsReadOnly="True" Height="520" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Copy All" Command="{Binding CopyManualCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
