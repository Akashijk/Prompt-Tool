<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PromptTool.Views.MultiLineTextInputDialog"
        Title="Input"
        Width="560"
        Height="520"
        MinWidth="460"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Border Classes="dialog-root">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource DialogRowSpacing}">
            <StackPanel Grid.Row="0" Classes="dialog-header">
                <TextBlock Classes="dialog-title" Text="{Binding $parent[Window].Title}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="{StaticResource DialogSectionSpacing}" MinHeight="0">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
                <TextBox x:Name="InputBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="280"
                         VerticalAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Classes="dialog-footer">
                <Button Content="Cancel" Width="90" Click="OnCancel" IsCancel="True"/>
                <Button Content="OK" Width="90" Click="OnOk" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
