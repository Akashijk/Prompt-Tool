<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PromptTool.ViewModels"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
        x:Class="PromptTool.Views.HistoryIntegrityWindow"
        x:DataType="vm:HistoryIntegrityViewModel"
        Title="History Integrity"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Scan Missing" Command="{Binding ScanMissingCommand}"/>
            <Button Content="Remove Missing" Command="{Binding PruneMissingCommand}"/>
            <Button Content="Recover Orphans" Command="{Binding RecoverOrphansCommand}"/>
            <Button Content="Verify Thumbnails" Command="{Binding VerifyThumbnailsCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding MissingImageCount, StringFormat='Missing: {0}'}" Classes="subtle"/>
            <TextBlock Text="{Binding OrphanRecoveredImages, StringFormat='Recovered images: {0}'}" Classes="subtle"/>
            <TextBlock Text="{Binding ThumbnailFailureCount, StringFormat='Thumb failures: {0}'}" Classes="subtle"/>
        </StackPanel>

        <TextBox Grid.Row="2"
                 Text="{Binding ReportText}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
