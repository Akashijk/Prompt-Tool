<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PromptTool.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="PromptTool.Views.HistoryViewerWindow"
        x:Name="HistoryWindow"
        x:DataType="vm:HistoryViewerViewModel"
        Title="{Binding WorkflowFilter, StringFormat='History Viewer ({0})'}"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:HistoryViewerViewModel />
    </Design.DataContext>

        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="2*,8,2*" Margin="10" ColumnSpacing="10" RowSpacing="8">
            <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                <TextBox Width="260" Watermark="Search prompt, status, template..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox Content="Favorites only" IsChecked="{Binding ShowFavoritesOnly}"/>
                <CheckBox Content="Group lineages" IsChecked="{Binding GroupLineages}"/>
                <ComboBox Width="120" SelectedItem="{Binding WorkflowFilter}">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="SFW"/>
                    <ComboBoxItem Content="NSFW"/>
                </ComboBox>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
                <Button Content="All Images" Command="{Binding ShowAllImagesCommand}"/>
                <Button Content="Model Similarity..."
                        Command="{Binding ShowModelSimilarityCommand}"
                        ToolTip.Tip="Analyze the selected history entry for near-identical output across models."/>
                <Button Content="Collapse All"
                        Command="{Binding CollapseAllLineagesCommand}"
                        IsEnabled="{Binding GroupLineages}"/>
                <Button Content="Expand All"
                        Command="{Binding ExpandAllLineagesCommand}"
                        IsEnabled="{Binding GroupLineages}"/>
                <Button Content="Merge Selected" Command="{Binding MergeSelectedEntriesCommand}" IsEnabled="{Binding CanMergeEntries}"/>
                <Button Content="Prune Missing" Command="{Binding PruneMissingImagesCommand}"/>
                <Button Content="Recover Orphans" Command="{Binding RecoverOrphanImagesCommand}"/>
                <Button Content="GC Orphans" Command="{Binding GarbageCollectOrphansCommand}"/>
                <TextBlock Text="{Binding StatusNote}" Classes="subtle" VerticalAlignment="Center"/>
            </WrapPanel>

        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*">
            <Border BorderBrush="#404040" BorderThickness="0,0,0,1" Padding="6,4">
                <Grid ColumnDefinitions="50,120,150,*,120">
                    <TextBlock Text="★" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="Thumbnail" Grid.Column="1" FontWeight="Bold"/>
                    <TextBlock Text="Timestamp" Grid.Column="2" FontWeight="Bold"/>
                    <TextBlock Text="Template" Grid.Column="3" FontWeight="Bold"/>
                    <TextBlock Text="Status" Grid.Column="4" FontWeight="Bold"/>
                </Grid>
            </Border>
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding HistoryEntries}"
                      SelectedItem="{Binding SelectedHistoryEntry}"
                      SelectionMode="Extended"
                      SelectionChanged="OnHistorySelectionChanged"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      CanUserReorderColumns="True"
                      HeadersVisibility="None">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding}">
                        <MenuItem Header="Model Similarity..."
                                  Command="{Binding ShowModelSimilarityCommand}"
                                  ToolTip.Tip="Run model similarity analysis for the selected history entry."/>
                        <MenuItem Header="Enhance"
                                  Command="{Binding EnhanceCommand}"
                                  IsVisible="{Binding CanEnhanceSelected}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="★" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        Command="{Binding DataContext.ToggleEntryFavoriteCommand, ElementName=HistoryWindow}"
                                        CommandParameter="{Binding}">
                                    <PathIcon Width="16" Height="16"
                                              Data="M12,2 L14.9,8.6 L22,9.3 L16.5,13.8 L18.2,21 L12,17.3 L5.8,21 L7.5,13.8 L2,9.3 L9.1,8.6 Z"
                                              Foreground="{Binding IsFavorite, Converter={StaticResource BoolToBrushConverter}}"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Thumbnail" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#404040" BorderThickness="1" Padding="2" Background="#1A1A1A">
                                    <Image Source="{Binding Cover}"
                                           Width="112"
                                           Height="70"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
                    <DataGridTemplateColumn Header="Template" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:HistoryEntryItem">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Width="20"
                                            Height="20"
                                            Padding="0"
                                            Content="{Binding LineageGlyph}"
                                            Command="{Binding DataContext.ToggleLineageExpansionCommand, ElementName=HistoryWindow}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding HasChildVariationRuns}"/>
                                    <TextBlock Text="{Binding DisplayTemplate}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" Background="Gray" HorizontalAlignment="Center"/>

        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" x:Name="DetailsScroll">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding WorkflowFilter}" FontWeight="Bold"/>

                <Border BorderBrush="#505050" BorderThickness="1" CornerRadius="4" Background="#2D2D30" Padding="6" Height="320">
                    <Grid>
                        <Image Source="{Binding SelectedImage}" Stretch="Uniform"/>
                        <Button Content="View Large" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                                Command="{Binding ViewLargeCommand}" CommandParameter="{Binding SelectedImageItem}" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding CurrentImagePositionText}"
                           Classes="subtle"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding CurrentImagePositionText, Converter={StaticResource StringToBoolConverter}}"/>

                <Expander IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Summary" FontWeight="Bold"/>
                            <TextBlock Text="(click to collapse)" Classes="subtle"/>
                        </StackPanel>
                    </Expander.Header>
                    <Border BorderBrush="#505050" BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Prompt view:" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding PromptVariants}"
                                          SelectedItem="{Binding SelectedPromptVariant}"
                                          MinWidth="200">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedPromptBanner}"
                                       Classes="subtle"
                                       IsVisible="{Binding ShowSelectedPromptBanner}"/>
                            <TextBox Text="{Binding DetailsText}"
                                     TextWrapping="Wrap"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"/>
                            <TextBlock Text="Double-click an image for full details." Classes="subtle"/>
                            <Button Content="Copy Prompt" Command="{Binding CopyPromptCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander IsExpanded="True" IsVisible="{Binding HasLineageInspector}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Lineage Inspector" FontWeight="Bold"/>
                            <TextBlock Text="(parent + child runs)" Classes="subtle"/>
                        </StackPanel>
                    </Expander.Header>
                    <Border BorderBrush="#505050" BorderThickness="1" CornerRadius="4" Padding="6">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding LineageInspectorSummary}" Classes="subtle" TextWrapping="Wrap"/>

                            <Border BorderBrush="#505050" BorderThickness="1" CornerRadius="4" Padding="6"
                                    IsVisible="{Binding HasLineageParent}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Parent Entry" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding LineageParent.SummaryText}" TextWrapping="Wrap"/>
                                    <Button Content="Open Parent"
                                            HorizontalAlignment="Left"
                                            Command="{Binding OpenLineageParentCardCommand}"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding LineageChildRuns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LineageChildRunCardViewModel">
                                        <Border BorderBrush="#505050" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding StatsText}" Classes="subtle" TextWrapping="Wrap"/>
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Content="Open"
                                                            MinWidth="96"
                                                            Margin="0,0,8,8"
                                                            Command="{Binding DataContext.OpenLineageChildRunCommand, ElementName=HistoryWindow}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Compare to Parent"
                                                            MinWidth="146"
                                                            Margin="0,0,8,8"
                                                            Command="{Binding DataContext.CompareLineageChildBestCommand, ElementName=HistoryWindow}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Favorite Best"
                                                            MinWidth="120"
                                                            Margin="0,0,8,8"
                                                            Command="{Binding DataContext.FavoriteLineageChildBestCommand, ElementName=HistoryWindow}"
                                                            CommandParameter="{Binding}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Expander>

                <Border BorderBrush="#505050" BorderThickness="1" CornerRadius="4" Padding="6">
                        <ListBox x:Name="SelectedImagesList"
                                 ItemsSource="{Binding SelectedImages}"
                             SelectedItem="{Binding SelectedImageItem}"
                             SelectionMode="Single"
                             BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="180" ItemHeight="210" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryImageItem">
                                <Border Margin="6"
                                        Padding="6"
                                        Width="180"
                                        Height="210"
                                        BorderBrush="#404040"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        DoubleTapped="Image_DoubleTapped">
                                                                         <Border.ContextMenu>
                                                                            <ContextMenu>
                                                                                <MenuItem Header="Open">
                                                                                    <MenuItem Header="Open Image"
                                                                                              Command="{Binding DataContext.OpenImageCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"/>
                                                                                    <MenuItem Header="Open Containing Folder"
                                                                                              Command="{Binding DataContext.OpenContainingFolderCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"/>
                                                                                    <MenuItem Header="View Large"
                                                                                              Command="{Binding DataContext.ViewLargeCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"/>
                                                                                    <MenuItem Header="Show Similar Matches"
                                                                                              Command="{Binding DataContext.ShowSimilarMatchesForImageCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"/>
                                                                                </MenuItem>
                                                                                <MenuItem Header="Generate">
                                                                                    <MenuItem Header="Generate More (from Image)..."
                                                                                              Command="{Binding DataContext.GenerateMoreCommand, ElementName=HistoryWindow}"
                                                                                              IsEnabled="{Binding DataContext.IsEnhancing, ElementName=HistoryWindow, Converter={StaticResource InverseBoolConverter}}"/>
                                                                                    <MenuItem Header="Generate New from Prompt..."
                                                                                              Command="{Binding DataContext.GenerateNewCommand, ElementName=HistoryWindow}"
                                                                                              IsEnabled="{Binding DataContext.IsEnhancing, ElementName=HistoryWindow, Converter={StaticResource InverseBoolConverter}}"/>
                                                                                    <MenuItem Header="Edit &amp; Regenerate..."
                                                                                              Command="{Binding DataContext.EditAndRegenerateCommand, ElementName=HistoryWindow}"
                                                                                              IsEnabled="{Binding DataContext.IsEnhancing, ElementName=HistoryWindow, Converter={StaticResource InverseBoolConverter}}"/>
                                                                                </MenuItem>
                                                                                <MenuItem Header="Variations">
                                                                                    <MenuItem Header="Generate Seed Variations"
                                                                                              Command="{Binding DataContext.GenerateSeedVariationsCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"
                                                                                              IsEnabled="{Binding DataContext.IsEnhancing, ElementName=HistoryWindow, Converter={StaticResource InverseBoolConverter}}"/>
                                                                                    <MenuItem Header="Create Prompt Variations..."
                                                                                              Command="{Binding DataContext.GeneratePromptVariationsCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"
                                                                                              IsEnabled="{Binding DataContext.IsEnhancing, ElementName=HistoryWindow, Converter={StaticResource InverseBoolConverter}}"/>
                                                                                    <MenuItem Header="Generate LoRA Variations"
                                                                                              Command="{Binding DataContext.GenerateLoraVariationsCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"
                                                                                              IsEnabled="{Binding DataContext.IsEnhancing, ElementName=HistoryWindow, Converter={StaticResource InverseBoolConverter}}"/>
                                                                                </MenuItem>
                                                                                <MenuItem Header="Metadata">
                                                                                    <MenuItem Header="Open in PNG Metadata Viewer"
                                                                                              Command="{Binding DataContext.ShowPngMetadataCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"/>
                                                                                    <MenuItem Header="Copy Prompt"
                                                                                              Command="{Binding DataContext.CopyPromptCommand, ElementName=HistoryWindow}"/>
                                                                                    <MenuItem Header="Copy Generation JSON"
                                                                                              Command="{Binding DataContext.CopyGenerationJsonCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"/>
                                                                                    <MenuItem Header="Edit Generation JSON"
                                                                                              Command="{Binding DataContext.EditGenerationJsonCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"/>
                                                                                </MenuItem>
                                                                                <MenuItem Header="Manage">
                                                                                    <MenuItem Header="Favorite Entry"
                                                                                              Command="{Binding DataContext.SetEntryFavoriteCommand, ElementName=HistoryWindow}"/>
                                                                                    <MenuItem Header="Toggle Image Favorite"
                                                                                              Command="{Binding DataContext.ToggleImageFavoriteCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"/>
                                                                                    <MenuItem Header="Set as Cover Image"
                                                                                              Command="{Binding DataContext.SetCoverImageCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"/>
                                                                                    <MenuItem Header="Open Parent Entry"
                                                                                              Command="{Binding DataContext.OpenParentEntryCommand, ElementName=HistoryWindow}"
                                                                                              IsEnabled="{Binding DataContext.CanOpenParentEntry, ElementName=HistoryWindow}"/>
                                                                                    <MenuItem Header="Select Child Variation Runs"
                                                                                              Command="{Binding DataContext.SelectChildVariationRunsCommand, ElementName=HistoryWindow}"
                                                                                              IsEnabled="{Binding DataContext.CanOpenChildVariationRuns, ElementName=HistoryWindow}"/>
                                                                                    <MenuItem Header="Enhance"
                                                                                              Command="{Binding DataContext.EnhanceCommand, ElementName=HistoryWindow}"
                                                                                              IsEnabled="{Binding DataContext.IsEnhancing, ElementName=HistoryWindow, Converter={StaticResource InverseBoolConverter}}"/>
                                                                                    <MenuItem Header="Upscale..."
                                                                                              Command="{Binding DataContext.UpscaleImageCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"/>
                                                                                    <MenuItem Header="Delete Image"
                                                                                              Command="{Binding DataContext.DeleteImageCommand, ElementName=HistoryWindow}"
                                                                                              CommandParameter="{Binding}"/>
                                                                                </MenuItem>
                                                                            </ContextMenu>
                                                                        </Border.ContextMenu>
                                    <Border ToolTip.Tip="{Binding Bitmap}">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <CheckBox VerticalAlignment="Top"
                                                      IsChecked="{Binding IsSelected}"
                                                      ToolTip.Tip="Select for bulk delete"/>
                                            <Border Grid.Column="1"
                                                    Width="168"
                                                    Height="94"
                                                    Background="#1A1A1A"
                                                    CornerRadius="4">
                                                <Image Source="{Binding Bitmap}"
                                                       Width="168"
                                                       Height="94"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ModelLabel}"
                                                       Classes="subtle"
                                                       MaxWidth="168"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding ModelLabel}"
                                                       IsVisible="{Binding ModelLabel, Converter={StaticResource StringToBoolConverter}}"/>
                                            <Button Content="{Binding SimilarityLabel}"
                                                    Classes="subtle"
                                                    MaxWidth="168"
                                                    HorizontalAlignment="Left"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ToolTip.Tip="Show near-duplicate matches"
                                                    Command="{Binding DataContext.ShowSimilarMatchesForImageCommand, ElementName=HistoryWindow}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding HasNearDuplicate}"/>
                                            <TextBlock Text="{Binding SeedLabel}"
                                                       Classes="subtle"
                                                       MaxWidth="168"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding SeedLabel}"
                                                       IsVisible="{Binding SeedLabel, Converter={StaticResource StringToBoolConverter}}"/>
                                            <TextBlock Text="{Binding LoraLabel}"
                                                       Classes="subtle"
                                                       MaxWidth="168"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding LoraLabel}"
                                                       IsVisible="{Binding LoraLabel, Converter={StaticResource StringToBoolConverter}}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Padding="4"
                                                        ToolTip.Tip="Favorite image"
                                                        Command="{Binding DataContext.ToggleImageFavoriteCommand, ElementName=HistoryWindow}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Width="14" Height="14"
                                                              Data="M12,2 L14.9,8.6 L22,9.3 L16.5,13.8 L18.2,21 L12,17.3 L5.8,21 L7.5,13.8 L2,9.3 L9.1,8.6 Z"
                                                              Foreground="{Binding Image.IsFavorite, Converter={StaticResource BoolToBrushConverter}}"/>
                                                </Button>
                                                <Button Padding="4"
                                                        ToolTip.Tip="Set cover image"
                                                        Command="{Binding DataContext.SetCoverImageCommand, ElementName=HistoryWindow}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Width="14" Height="14"
                                                              Data="M3,4 H21 V20 H3 Z M5,6 V18 H19 V6 Z M7,16 L11,12 L14,15 L16,13 L18,16 V18 H7 Z"/>
                                                </Button>
                                                <Button Padding="4"
                                                        ToolTip.Tip="Edit JSON"
                                                        Command="{Binding DataContext.EditGenerationJsonCommand, ElementName=HistoryWindow}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Width="14" Height="14"
                                                              Data="M8,3 L6,3 C4.89,3 4,3.89 4,5 L4,9 C4,10.11 3.11,11 2,11 L2,13 C3.11,13 4,13.89 4,15 L4,19 C4,20.11 4.89,21 6,21 L8,21 L8,19 L6,19 L6,15 C6,13.9 5.1,13 4,13 L4,11 C5.1,11 6,10.1 6,9 L6,5 L8,5 L8,3 M16,3 L16,5 L18,5 L18,9 C18,10.1 18.9,11 20,11 L20,13 C18.9,13 18,13.9 18,15 L18,19 L16,19 L16,21 L18,21 C19.11,21 20,20.11 20,19 L20,15 C20,13.89 20.89,13 22,13 L22,11 C20.89,11 20,10.11 20,9 L20,5 C20,3.89 19.11,3 18,3 L16,3 Z"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
        </ScrollViewer>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Favorite" Command="{Binding ToggleFavoriteCommand}"/>
                <Button Content="Delete Selected Images"
                        Command="{Binding DeleteSelectedImagesCommand}"
                        IsEnabled="{Binding CanDeleteSelectedImages}"/>
                <Button Content="Delete Entry" Command="{Binding DeleteEntryCommand}"/>
                <Button Content="Open Folder" Command="{Binding OpenContainingFolderCommand}" CommandParameter="{Binding SelectedImageItem}"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
                <Button Content="Enhance"
                        Command="{Binding EnhanceCommand}"
                        IsVisible="{Binding CanEnhanceSelected}"
                        IsEnabled="{Binding IsEnhancing, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Generate New..."
                        Command="{Binding GenerateNewCommand}"
                        IsEnabled="{Binding IsEnhancing, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Generate More..."
                        Command="{Binding GenerateMoreCommand}"
                        IsEnabled="{Binding IsEnhancing, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Prompt Variations..."
                        Command="{Binding GeneratePromptVariationsCommand}"
                        IsEnabled="{Binding IsEnhancing, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Generate Missing Enhancements"
                        Command="{Binding FillMissingVariationsCommand}"
                        IsVisible="{Binding CanFillMissingVariations}"
                        IsEnabled="{Binding IsEnhancing, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Open Parent"
                        Command="{Binding OpenParentEntryCommand}"
                        IsEnabled="{Binding CanOpenParentEntry}"/>
                <Button Content="Child Runs"
                        Command="{Binding SelectChildVariationRunsCommand}"
                        IsEnabled="{Binding CanOpenChildVariationRuns}"/>
                <Button Content="Load Prompt" Command="{Binding LoadPromptFromHistoryCommand}" Classes="accent"/>
                <Button Content="Close" Command="{Binding CancelCommand}" IsCancel="True"/>
            </StackPanel>
        </Grid>

</Window>
