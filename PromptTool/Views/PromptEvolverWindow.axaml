<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PromptTool.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="PromptTool.Views.PromptEvolverWindow"
        x:DataType="vm:PromptEvolverViewModel"
        Title="Prompt Evolver"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:PromptEvolverViewModel />
    </Design.DataContext>

    <Border Padding="15">
        <StackPanel Spacing="10">
            <TextBlock Text="Original Prompt:" FontWeight="Bold"/>
            <TextBox Text="{Binding OriginalPrompt}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Ollama Model:" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding OllamaModels}" SelectedItem="{Binding SelectedOllamaModel}" MinWidth="200"/>
                <Button Content="Evolve" Command="{Binding EvolveAsyncCommand}" IsEnabled="{Binding !IsBusy}"/>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="100"/>
            </StackPanel>

            <TextBlock Text="Evolved Prompt:" FontWeight="Bold"/>
            <TextBox Text="{Binding EvolvedPrompt}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="200"/>
        </StackPanel>
    </Border>

</Window>
