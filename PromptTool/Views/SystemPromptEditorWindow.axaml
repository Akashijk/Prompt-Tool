<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PromptTool.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="PromptTool.Views.SystemPromptEditorWindow"
        x:DataType="vm:SystemPromptEditorViewModel"
        Title="System Prompts"
        WindowStartupLocation="CenterOwner"
        Width="720"
        Height="560"
        MinWidth="640"
        MinHeight="480"
        SizeToContent="Manual">

    <Design.DataContext>
        <vm:SystemPromptEditorViewModel />
    </Design.DataContext>

    <Border Classes="dialog-root">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource DialogRowSpacing}">
            <StackPanel Grid.Row="0" Classes="dialog-header">
                <TextBlock Classes="dialog-title" Text="System Prompts"/>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="240,6,*" ColumnSpacing="0">
                <Grid Grid.Column="0" RowDefinitions="Auto,* ,Auto" RowSpacing="6" Margin="0,0,10,0">
                    <TextBlock Text="Files" FontWeight="Bold"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding PromptFiles}" SelectedItem="{Binding SelectedPromptFile}"
                             MinHeight="240"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Content="Reload" Command="{Binding LoadFilesCommand}" HorizontalAlignment="Left"/>
                </Grid>

                <GridSplitter Grid.Column="1" Background="LightGray" Width="6"/>

                <Border Grid.Column="2" BorderBrush="#505050" BorderThickness="1" CornerRadius="4" Padding="8" Background="#1E1E1E">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding SelectedPromptFile.DisplayName}" FontWeight="Bold"/>
                        <TextBox Text="{Binding PromptContent}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="280" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </Grid>

            <DockPanel Grid.Row="2" LastChildFill="False">
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
