<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PromptTool.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="PromptTool.Views.AllImagesWindow"
        x:DataType="vm:AllImagesViewerViewModel"
        Title="All Images"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,*" Margin="10" RowSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Compare Selected" Command="{Binding CompareSelectedCommand}" IsEnabled="{Binding CanCompare}"/>
            <Button Content="{Binding ExpandAllLabel}" Command="{Binding ToggleExpandAllCommand}"/>
            <CheckBox Content="Favorites only" IsChecked="{Binding ShowFavoritesOnly}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}" Classes="subtle" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TemplateImageGroup">
                        <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Count, StringFormat='({0})'}" Classes="subtle"/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Images}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="200" ItemHeight="240" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GalleryImageItem">
                                        <Border Margin="4" Padding="6"
                                                BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Width="190"
                                                Height="230"
                                                PointerPressed="Image_PointerPressed"
                                                DoubleTapped="Image_DoubleTapped">
                                            <StackPanel Spacing="4">
                                                <Image Source="{Binding Bitmap}" Width="176" Height="110" Stretch="UniformToFill"/>
                                                <TextBlock Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="176"
                                                           ToolTip.Tip="{Binding Label}"/>
                                                <TextBlock Text="{Binding ModelLabel}"
                                                           Classes="subtle"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="176"
                                                           ToolTip.Tip="{Binding ModelLabel}"
                                                           IsVisible="{Binding ModelLabel, Converter={StaticResource StringToBoolConverter}}"/>
                                                <TextBlock Text="{Binding SeedLabel}"
                                                           Classes="subtle"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="176"
                                                           ToolTip.Tip="{Binding SeedLabel}"
                                                           IsVisible="{Binding SeedLabel, Converter={StaticResource StringToBoolConverter}}"/>
                                                <TextBlock Text="{Binding LoraLabel}"
                                                           Classes="subtle"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="176"
                                                           ToolTip.Tip="{Binding LoraLabel}"
                                                           IsVisible="{Binding LoraLabel, Converter={StaticResource StringToBoolConverter}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="1"
                   Text="Loading images…"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="{Binding IsLoading}"
                   Classes="subtle"/>
    </Grid>
</Window>
